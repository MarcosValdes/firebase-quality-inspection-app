rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /reports/{reportId} {
      // Allow a user to read any report, but only create or update their own.
      allow read: if request.auth != null;
      allow create, update: if request.auth.uid == request.resource.data.inspectorId;
      
      // Deny deletes for now unless you have a specific need.
      allow delete: if false;
    }
    match /issues/{issueId} {
        // Allow a user to read any issue, but only create/update their own
        allow read: if request.auth != null;
        allow create, update: if request.auth.uid == request.resource.data.inspectorId;
    }
    match /logs/{logId} {
        // Allow any authenticated user to create a log entry.
        // Deny read, update, and delete to prevent users from accessing logs.
        allow create: if request.auth != null;
        allow read, update, delete: if false;
    }
  }
}