rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow users to upload their own report audio and issue images.
    match /audio/{reportId}/{fileName} {
      allow write: if request.auth != null;
    }
    match /images/{reportId}/{issueId}/{fileName} {
      allow write: if request.auth != null;
    }
  }
}
